<launch>
    <!-- TF from Encoder Odometry -->
    <node name="encoder_to_tf" pkg="first_project" type="odom_to_tf" output="screen">
        <param name="root_frame" value="world"/>
        <param name="child_frame" value="wheel_odom"/>
        <remap from="input_odom" to="/odom"/>
    </node>

    <!-- TF from GPS Odometry -->
    <node name="gps_to_tf" pkg="first_project" type="odom_to_tf" output="screen">
        <param name="root_frame" value="world"/>
        <param name="child_frame" value="gps_odom"/>
        <remap from="input_odom" to="/gps_odom"/>
    </node>
</launch>
